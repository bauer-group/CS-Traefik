# =============================================================================
# CS-Traefik - Environment Configuration
# =============================================================================
# BAUER GROUP modernised Traefik v3 reverse-proxy stack with opt-in
# observability and auto-update profiles.
#
# Usage:
#   cp .env.example .env             # then edit by hand, OR
#   ./install.sh                     # interactive wizard (recommended)
#
# Every value below has a sensible default in docker-compose.yml. Override
# only what you need; the rest stays on the documented default.
# =============================================================================


# -----------------------------------------------------------------------------
# STACK IDENTIFICATION
# -----------------------------------------------------------------------------
# Compose project name -- prefixes all containers/volumes/networks.
# Change ONLY if you run multiple Traefik stacks on the same Docker host.
STACK_NAME=edgeproxy

# Default network name. The legacy stack used "EDGEPROXY" -- kept identical
# so existing service stacks that attach to this network keep working.
# Internal monitoring traffic uses "${NETWORK_NAME}-internal".
NETWORK_NAME=EDGEPROXY

# Timezone for all services (affects log timestamps + cron schedules).
# IANA tz database name (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones).
TIME_ZONE=Etc/UTC

# Where Traefik (and the monitoring profile) will store persistent state on
# the Docker host. ACME certificates, Grafana DB, Prometheus TSDB, Loki
# chunks, and bind-mounted config all live here.
#   Recommended: /opt/edgeproxy   (Linux production)
#   Local dev:   ./data
DATA_DIRECTORY=/opt/edgeproxy


# -----------------------------------------------------------------------------
# COMPOSE PROFILES (feature toggles)
# -----------------------------------------------------------------------------
# Activate optional features by adding profile names (comma-separated).
# Empty / unset = core stack only (just Traefik) -- this is the DEFAULT.
#
#   monitoring   -> Prometheus + Grafana + Loki + Promtail + Alertmanager +
#                   node-exporter + cAdvisor (full observability).
#                   Reachable on the api entrypoint at /grafana, /prometheus,
#                   /alertmanager. NOT publicly exposed by default.
#   auto-update  -> Watchtower keeps every labelled image current on a
#                   weekly schedule with rolling restart.
#
# Examples:
#   COMPOSE_PROFILES=                          # core only (DEFAULT)
#   COMPOSE_PROFILES=monitoring                # core + observability
#   COMPOSE_PROFILES=monitoring,auto-update    # the full ride
#
# Compose reads this variable natively, so `docker compose up -d` activates
# the right services without extra `--profile` flags.
COMPOSE_PROFILES=


# -----------------------------------------------------------------------------
# TRAEFIK CORE
# -----------------------------------------------------------------------------
# Image tag. v3 is the current LTS major; pin to a minor (e.g. v3.6) in
# production so a Watchtower-triggered v4 jump can't surprise you.
# Releases: https://github.com/traefik/traefik/releases
TRAEFIK_IMAGE_TAG=v3.6

# Public ports. 80/443 are the defaults; only change if Traefik must coexist
# with another listener on those ports.
HTTP_PORT=80
HTTPS_PORT=443

# Log level: ERROR, WARN, INFO, DEBUG, TRACE.
# INFO is the right setting for production. DEBUG only when actively
# troubleshooting (it logs every routing decision and is very chatty).
LOG_LEVEL=INFO

# Access-log format: common (Apache-style) or json (recommended for Loki).
ACCESS_LOG_FORMAT=json


# -----------------------------------------------------------------------------
# ADMIN ACCESS (security-critical)
# -----------------------------------------------------------------------------
# The Traefik dashboard, Grafana, Prometheus, and Alertmanager are reached
# through the dedicated `api` entrypoint. By default it binds to
# 127.0.0.1:9090 ONLY -- the dashboard is invisible from the public
# internet. Reach it via SSH-tunnel:
#
#   ssh -L 9090:127.0.0.1:9090 user@server
#   open http://127.0.0.1:9090/dashboard/
#                             /grafana/
#                             /prometheus/
#                             /alertmanager/
#
# This is the legacy EDGEPROXY pattern -- low attack surface, BasicAuth
# always enforced as defence-in-depth.

# Internal port for the admin entrypoint (any free port; 9090 is the
# legacy default).
API_PORT=9090

# Bind interface. Choose one:
#   127.0.0.1  -> loopback only (DEFAULT, most secure -- SSH-tunnel to reach).
#   0.0.0.0    -> all interfaces (LAN-accessible, BasicAuth-only -- no TLS
#                 on this entrypoint by default; use API_HOST for public TLS).
API_BIND=127.0.0.1

# OPTIONAL: dedicated FQDN for public access to admin UIs over HTTPS.
# Leave EMPTY to keep admin UIs localhost-only (the default and most
# secure mode).
#
# When set, an additional router activates on web-secure (port 443) with:
#   * Let's Encrypt TLS
#   * BasicAuth (the same API_USERS below)
#   * IP whitelist (the same API_WHITELIST below)
#   * /dashboard, /grafana, /prometheus, /alertmanager paths
#
# Pick a hostname THAT HOSTS NO APPLICATION (e.g. admin.bauer-group.com)
# so the admin path-prefixes can never collide with app routes.
# DNS A/AAAA must point to this host.
API_HOST=

# Base URL used by Grafana / Prometheus / Alertmanager to build self-links.
# Default = the loopback URL. Set to https://${API_HOST}/ if you set API_HOST
# above, otherwise users see broken redirects in the public router.
#   Local-only:  http://localhost:9090
#   Public mode: https://admin.bauer-group.com
API_BASE_URL=http://localhost:9090

# IP whitelist (comma-separated CIDRs). ALWAYS keep this tight -- BasicAuth
# alone is not enough for an admin surface.
#   127.0.0.1/32      -> localhost
#   ::1/128           -> localhost IPv6
#   192.168.0.0/16    -> private LAN (RFC1918)
#   10.0.0.0/8        -> private LAN (RFC1918)
#   172.16.0.0/12     -> private LAN (RFC1918)
#   100.64.0.0/10     -> WireGuard / Tailscale CGNAT (typical)
API_WHITELIST=127.0.0.1/32, ::1/128, 192.168.0.0/16, 10.0.0.0/8

# BasicAuth credentials -- htpasswd format with bcrypt.
# Generate with:
#   echo $(htpasswd -nB admin) | sed -e 's/\$/\$\$/g'
# The double-$$ escaping is required because Compose expands $VAR.
# Default below is admin/admin -- CHANGE THIS BEFORE EXPOSING.
API_USERS=admin:$$2y$$05$$DOl/8qcUKvTIMqgvKDKPwO/mMluxUb9gT/jWqDbkedqByHpqlElHG


# -----------------------------------------------------------------------------
# LET'S ENCRYPT (automatic TLS for app routers)
# -----------------------------------------------------------------------------
# Email for ACME registration + expiry notifications. Required.
LETSENCRYPT_EMAIL=admin@example.com

# CA endpoint. Use staging while testing to avoid the production rate
# limit (5 duplicate certs/week, 50 certs/account/week).
#   production: https://acme-v02.api.letsencrypt.org/directory   (default)
#   staging:    https://acme-staging-v02.api.letsencrypt.org/directory
LETSENCRYPT_CA=https://acme-v02.api.letsencrypt.org/directory

# THREE resolvers are pre-wired in config/traefik/traefik.yml. App stacks
# pick whichever matches their network with a router label:
#
#   traefik.http.routers.foo.tls.certresolver=letsencrypt
#                                             letsencrypt-http
#                                             letsencrypt-staging
#
#   letsencrypt          -> TLS-ALPN-01 on port 443 (DEFAULT, like legacy).
#   letsencrypt-http     -> HTTP-01 on port 80.
#   letsencrypt-staging  -> staging endpoint for testing.
#
# DNS-01 (wildcard certs *.bauer-group.com): a template is COMMENTED OUT
# in traefik.yml. We currently have NO DNS-provider API integration --
# uncomment + add the provider env vars when that's set up.


# -----------------------------------------------------------------------------
# MANUAL CERTIFICATES (corporate CA, wildcards, internal-only domains)
# -----------------------------------------------------------------------------
# Drop your *.crt + *.key files into config/certs/static/ and reference
# them from config/traefik/dynamic/tls.yml. The directory is mounted
# read-only into Traefik and watched for changes -- no restart needed.
# Nothing else needs to be set here.


# -----------------------------------------------------------------------------
# MONITORING PROFILE (only when COMPOSE_PROFILES contains "monitoring")
# -----------------------------------------------------------------------------
# Image tags. Float on `latest` by default -- Watchtower (if active) keeps
# them fresh on the weekly schedule. Pin a digest in regulated environments.
PROMETHEUS_IMAGE_TAG=latest
GRAFANA_IMAGE_TAG=latest
LOKI_IMAGE_TAG=latest
PROMTAIL_IMAGE_TAG=latest
ALERTMANAGER_IMAGE_TAG=latest
CADVISOR_IMAGE_TAG=latest
NODE_EXPORTER_IMAGE_TAG=latest

# Grafana admin credentials. CHANGE THE DEFAULT BEFORE EXPOSING.
# Reachable via the api entrypoint at /grafana with API_USERS BasicAuth +
# API_WHITELIST IP-allow + Grafana's own login on top.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# Comma-separated list of Grafana plugins to install on first start.
# Empty = no extra plugins.
#   grafana-piechart-panel       -- legacy pie panel
#   grafana-clock-panel          -- timezone clock
#   grafana-worldmap-panel       -- geo overlay
GRAFANA_PLUGINS=

# Prometheus retention. Whichever limit (time or size) hits first wins.
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=8GB

# Scrape interval (Prometheus polling cadence).
# 15s is sane; 5s if you need fine-grained latency graphs.
PROMETHEUS_SCRAPE_INTERVAL=15s

# Loki retention (chunk lifetime). 168h = 7 days.
LOKI_RETENTION_PERIOD=168h


# -----------------------------------------------------------------------------
# AUTO-UPDATE PROFILE (only when COMPOSE_PROFILES contains "auto-update")
# -----------------------------------------------------------------------------
# Watchtower image. Default `nickfedor/watchtower:latest` is the community
# fork with rolling-restart support. Switch to `containrrr/watchtower:latest`
# for the upstream original.
WATCHTOWER_IMAGE=nickfedor/watchtower:latest

# Six-field cron (sec min hour dom month dow). Default = Sat 03:00 local.
# Examples:
#   "0 0 3 * * 6"    -> Saturday 03:00      (default; quiet weekend window)
#   "0 0 4 * * 0"    -> Sunday   04:00
#   "0 0 */6 * * *"  -> every 6 hours       (aggressive, NOT recommended)
WATCHTOWER_SCHEDULE=0 0 3 * * 6

# Wait this long for a clean container shutdown before SIGKILL. Match it
# to the longest stop_grace_period in the stack (Traefik default = 30s).
WATCHTOWER_TIMEOUT=60s

# Watchtower notifications (Slack, email, Telegram, ...). Disabled by default.
# See https://containrrr.dev/watchtower/notifications/ for full reference.
# WATCHTOWER_NOTIFICATIONS=slack
# WATCHTOWER_NOTIFICATION_SLACK_HOOK_URL=
# WATCHTOWER_NOTIFICATION_SLACK_IDENTIFIER=edgeproxy


# -----------------------------------------------------------------------------
# RESOURCE LIMITS (host protection)
# -----------------------------------------------------------------------------
# Per-service caps so a runaway component can't starve the host.
# Tune for your hardware. Defaults assume a modest single-host deployment.
TRAEFIK_CPU_LIMIT=2
TRAEFIK_MEMORY_LIMIT=512m

PROMETHEUS_CPU_LIMIT=2
PROMETHEUS_MEMORY_LIMIT=2g

GRAFANA_CPU_LIMIT=1
GRAFANA_MEMORY_LIMIT=512m

LOKI_CPU_LIMIT=1
LOKI_MEMORY_LIMIT=1g


# -----------------------------------------------------------------------------
# LOGGING (Docker json-file driver)
# -----------------------------------------------------------------------------
# Per-container log rotation. Default = 50 MB x 5 files = 250 MB max.
LOG_MAX_SIZE=50m
LOG_MAX_FILE=5
