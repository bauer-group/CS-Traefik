# =============================================================================
# CS-Traefik - Environment Configuration
# =============================================================================
# BAUER GROUP modernised Traefik v3 reverse-proxy stack with opt-in
# observability and auto-update profiles.
#
# Two kinds of entries:
#
#   * UNCOMMENTED (active)   -- values without a sensible default OR
#                               stability pins. These ship enabled
#                               and apply to every deployment.
#   * COMMENTED OUT          -- every OTHER configurable variable.
#                               These already have working defaults
#                               in docker-compose.yml. Uncomment the
#                               lines you want to override; copying
#                               them to your local .env is enough.
#
# This dual layout is intentional: keeps `git diff .env.example` quiet
# on routine stack updates (only operator-set values appear in your
# .env) while preserving the inline reference of WHAT can be tuned and
# WHAT each variable does -- you should rarely need to read external
# docs to flip a switch.
#
# Usage:
#   cp .env.example .env             # then edit by hand, OR
#   ./install.sh                     # interactive wizard (recommended)
#
# Full reference (with side-effect explanations beyond what fits inline):
#   docs/configuration.md
# =============================================================================


# -----------------------------------------------------------------------------
# STABILITY PINS  (active -- pinned to survive future upstream renames
# that would otherwise orphan containers / volumes)
# -----------------------------------------------------------------------------

# Compose project name -- prefixes all containers / volumes / networks.
# Pinned because changing it orphans existing containers on next start.
STACK_NAME=edgeproxy

# Public Docker network name -- service stacks attach by this exact name.
# Pinned because changing it breaks every attached app stack (they would
# need their `traefik.docker.network` labels updated in lockstep).
NETWORK_NAME=EDGEPROXY

# Network subnets. Defaults are RFC1918 high-end (172.30 / 172.31).
# Override ONLY if these collide with something on YOUR host:
#   * Tailscale uses ALL of 100.64.0.0/10 (the legacy v2 default of
#     100.64/16 + 100.65/16 collides on every Tailscale-enabled box).
#   * Hetzner Cloud Networks frequently allocate inside 10.0.0.0/8
#     and sometimes 100.64.0.0/10.
#   * Default Docker bridges use 172.17 .. ~172.20.
#   * Corporate LANs typically use 192.168.0.0/16 + 10.0.0.0/8.
#
# Pick a /16 inside RFC1918 (172.16-31, 192.168, 10/8) that nothing
# else on this host uses. The dashboard-internal router's ClientIP
# rule reads INTERNAL_SUBNET / INTERNAL_SUBNET_V6 too, so changing
# these stays consistent across the stack.
# Defaults: PROXY_SUBNET=172.30.65.0/16 / INTERNAL_SUBNET=172.30.64.0/16
# PROXY_SUBNET=172.30.65.0/16
# PROXY_SUBNET_V6=fdff:30:65::/64
# INTERNAL_SUBNET=172.30.64.0/16
# INTERNAL_SUBNET_V6=fdff:30:64::/64

# Persistent-state location on the Docker host. ACME certs, Grafana DB,
# Prometheus TSDB, Loki chunks, Traefik logs all live here.
#
# Default `./data` is RELATIVE to the compose project root (where
# docker-compose.yml lives). After the install.sh wizard clones the
# repo to e.g. /opt/edgeproxy/, this resolves to /opt/edgeproxy/data/
# -- a clean subdirectory that is .gitignored, so runtime state never
# pollutes the git working tree.
#
# Override with an absolute path for special cases:
#   * separate disk/SSD for the TSDB:  /mnt/fastdisk/edgeproxy
#   * /var/lib convention preference:  /var/lib/edgeproxy
#   * shared NFS-mounted state:        /srv/edgeproxy-state
# Do NOT set this to the install dir itself (e.g. /opt/edgeproxy) --
# that mixes runtime state with the cloned repo files.
#
# Common production topology: /var/lib/docker on a dedicated big
# volume, /opt (and the rest) on a smaller OS root. With the default
# `./data`, heavy state (Prometheus TSDB, Loki chunks) lives on the
# OS root and can fill it on long-retention deployments. If your
# host has that layout, mount /var/lib/edgeproxy on the big volume
# and override DATA_DIRECTORY here. See docs/installation.md ->
# "Disk layout considerations" for the three production patterns.
#
# Pinned (even with the relative default) because changing this AFTER
# first start orphans existing state.
DATA_DIRECTORY=./data

# Optional features (comma-separated profile names).
# Empty = core stack only (just Traefik) -- the safe default.
#
# Available profiles:
#   monitoring   -> Prometheus + Grafana + Loki + Promtail + Alertmanager
#                   + node-exporter + cAdvisor (full observability).
#                   Reachable on the api entrypoint at /grafana,
#                   /prometheus, /alertmanager. NOT publicly exposed.
#   auto-update  -> Watchtower (weekly rolling restart of labelled
#                   images).
#
# Profiles COMBINE -- list multiple comma-separated to activate them
# together. Order does not matter (compose evaluates them as a set).
# Examples:
#   COMPOSE_PROFILES=                       # core only (Traefik), DEFAULT
#   COMPOSE_PROFILES=monitoring             # core + observability
#   COMPOSE_PROFILES=auto-update            # core + Watchtower
#   COMPOSE_PROFILES=monitoring,auto-update # everything (typical production)
#
# Pinned (even though empty matches the compose default) so the intent
# is visible in `git diff` when the operator changes it.
COMPOSE_PROFILES=


# -----------------------------------------------------------------------------
# REQUIRED  (active -- no operational default, must be set per-deployment)
# -----------------------------------------------------------------------------

# BasicAuth credentials for the admin surface (htpasswd format with
# bcrypt, $$ -escaped because Compose expands $VAR).
#
# !!! THE BCRYPT HASH BELOW IS A FAIL-LOUD PLACEHOLDER -- the plaintext
# is unknown intentionally, so a deployment that forgets to rotate is
# locked out, not exposed via a guessable default like admin/admin. !!!
#
# How to set this properly:
#
#   * `install.sh` (curl|bash one-liner) -- the wizard generates a
#     random 24-char password, replaces this hash, AND appends the
#     plaintext as a `# === ADMIN_PLAINTEXT-BEGIN ===` comment block at
#     the bottom of the resulting .env so you can recover it. Delete
#     that block once stored in your password manager.
#
#   * `traefik.sh setup` -- re-runs the same wizard against an existing
#     install (will replace API_USERS and the comment block in place).
#
#   * Manual rotation (no wizard):
#       docker run --rm httpd:alpine htpasswd -nbB -C 10 admin '<your-pw>' \
#         | sed -e 's/\$/\$\$/g'
#     Paste the result on the line below. Cost 10 = ~100 ms per check
#     (production-acceptable). Bump to 12 if you face an offline-
#     cracking threat model.
API_USERS=admin:$$2y$$10$$bqEOV7NebZHIrdtw4ma5ruc1MsNPiTSfk29os5lCNCb55kTOvp0RS

# IP whitelist for EXTERNAL access to the admin surface. The
# EDGEPROXY-INTERNAL Docker subnet is ALWAYS allowed via a separate
# hardcoded router (`dashboard-internal`) -- this list does NOT need to
# (and should not) include it. See docs/admin-access.md for the full
# two-router model and segmentation rationale.
#
# DEFAULT BELOW IS MAXIMALLY RESTRICTIVE -- host loopback only. To
# reach the admin surface from anywhere else, you EITHER:
#   * SSH-tunnel to 127.0.0.1 (no whitelist edit needed), OR
#   * add the actually-needed CIDRs (LAN, VPN, office public IP)
#     EXPLICITLY here. Do not pre-add ranges "just in case."
#
# Common additions (add to the line below as needed):
#   192.168.0.0/16    -> private LAN (RFC1918 -- typical SOHO / corp)
#   10.0.0.0/8        -> private LAN (RFC1918 -- enterprise)
#   172.16.0.0/12     -> private LAN (RFC1918 -- Docker default bridge)
#   100.64.0.0/10     -> CGNAT (WireGuard / Tailscale meshes)
#   203.0.113.0/24    -> office public range (replace with yours)
API_WHITELIST=127.0.0.1/32, ::1/128


# =============================================================================
# OPTIONAL OVERRIDES (commented out -- uncomment to override compose defaults)
# =============================================================================


# -----------------------------------------------------------------------------
# Stack identity (extra)
# -----------------------------------------------------------------------------

# Timezone for all services (affects log timestamps + cron schedules).
# IANA tz database name.
# Default: Etc/UTC
# TIME_ZONE=Europe/Berlin


# -----------------------------------------------------------------------------
# Traefik core
# -----------------------------------------------------------------------------

# Image tag. v3 is the current LTS major; pin to a minor in production
# so a Watchtower-triggered v4 jump can't surprise you.
# Releases: https://github.com/traefik/traefik/releases
# Default: v3.6
# TRAEFIK_IMAGE_TAG=v3.6

# Public ports. 80/443 are the defaults; only change if Traefik must
# coexist with another listener on those ports.
# Defaults: 80 / 443
# HTTP_PORT=80
# HTTPS_PORT=443

# Log level: ERROR | WARN | INFO | DEBUG | TRACE
# INFO is right for production. DEBUG only when actively troubleshooting
# (logs every routing decision -- very chatty).
# Default: INFO
# LOG_LEVEL=DEBUG

# Access-log format: common (Apache-style) or json (recommended for Loki).
# Default: json
# ACCESS_LOG_FORMAT=common

# respondingTimeouts on web + web-secure entrypoints.
#
#   WEB_READ_TIMEOUT   -- upper bound on how long a request body may
#                         take. 0 = no upper bound. Required for large
#                         file uploads (S3 multipart on slow / mobile
#                         links), webhooks with long-running server
#                         logic. For slowloris hardening, set to e.g.
#                         600s (still allows 100 MB upload on
#                         128 kbit/s mobile, caps single-connection
#                         hold time).
#   WEB_WRITE_TIMEOUT  -- upper bound on how long the response may
#                         take. 0 = no upper bound. Required for SSE
#                         / event-stream responses, streaming
#                         downloads, slow backend queries.
#   WEB_IDLE_TIMEOUT   -- close keepalive connections idle for this
#                         long. 300s (5 min) is bumped from the
#                         legacy 180s so WebSocket apps without
#                         aggressive heartbeats don't get prematurely
#                         cut. Memory cost of half-dead connections
#                         is negligible (~1 KB each). Bump to 600s
#                         for IoT / MQTT-over-WS heavy workloads.
# Defaults: 0s / 0s / 300s
# WEB_READ_TIMEOUT=600s
# WEB_WRITE_TIMEOUT=0s
# WEB_IDLE_TIMEOUT=600s


# -----------------------------------------------------------------------------
# Admin access (extra knobs -- API_USERS + API_WHITELIST already active above)
# -----------------------------------------------------------------------------
# The Traefik dashboard, Grafana, Prometheus, and Alertmanager are reached
# through the dedicated `api` entrypoint. By default it binds to
# 127.0.0.1:9090 ONLY -- the dashboard is invisible from the public
# internet. Reach it via SSH-tunnel:
#
#   ssh -L 9090:127.0.0.1:9090 user@server
#   open http://127.0.0.1:9090/dashboard/

# Internal port for the admin entrypoint (any free port; 9090 is the
# legacy default).
# Default: 9090
# API_PORT=9090

# IPv4 / IPv6 bind interfaces. Choose in lock-step:
#   API_BIND=127.0.0.1   API_BIND_V6=::1   -> loopback only (DEFAULT, most secure)
#   API_BIND=0.0.0.0     API_BIND_V6=::    -> all interfaces (LAN-accessible)
# Defaults: 127.0.0.1 / ::1
# API_BIND=0.0.0.0
# API_BIND_V6=::

# OPTIONAL: dedicated FQDN for public access to admin UIs over HTTPS
# (mode 3). Leave EMPTY (compose default) to keep admin UIs
# localhost-only -- the safest mode.
#
# When set, an additional router activates on web-secure (port 443) with:
#   * Let's Encrypt TLS
#   * BasicAuth (the same API_USERS above)
#   * IP whitelist (the same API_WHITELIST above)
#   * /dashboard, /grafana, /prometheus, /alertmanager paths
#
# Pick a hostname that hosts NO application (e.g. admin.bauer-group.com)
# so the admin path-prefixes can never collide with app routes.
# DNS A/AAAA must point to this host.
# Default: empty (mode-3 disabled, fail-closed via never-match placeholder)
# API_HOST=admin.bauer-group.com

# Base URL used by Grafana / Prometheus / Alertmanager to build self-links.
# Default = the loopback URL. Set to https://${API_HOST}/ if you set
# API_HOST above; otherwise users see broken redirects.
# Default: http://localhost:9090
# API_BASE_URL=https://admin.bauer-group.com


# -----------------------------------------------------------------------------
# Let's Encrypt (automatic TLS)
# -----------------------------------------------------------------------------

# Email for ACME registration + expiry notifications.
# Default: info@bauer-group.com
# LETSENCRYPT_EMAIL=ops@example.com

# CA endpoint. Use staging while testing to avoid the production rate
# limit (5 duplicate certs/week, 50 certs/account/week).
#   production: https://acme-v02.api.letsencrypt.org/directory   (default)
#   staging:    https://acme-staging-v02.api.letsencrypt.org/directory
# Default: production
# LETSENCRYPT_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# FOUR resolvers are pre-wired in config/traefik/traefik.yml. App stacks
# pick whichever matches their network with a router label:
#
#   traefik.http.routers.foo.tls.certresolver=letsencrypt          # 1. HTTP-01 (DEFAULT)
#   traefik.http.routers.foo.tls.certresolver=letsencrypt-tls      # 2. TLS-ALPN-01
#   traefik.http.routers.foo.tls.certresolver=letsencrypt-dns      # 3. DNS-01 (wildcards)
#   traefik.http.routers.foo.tls.certresolver=letsencrypt-staging  # X. testing


# -----------------------------------------------------------------------------
# DNS-01 challenge (wildcards, firewalled hosts)
# -----------------------------------------------------------------------------
# Required for wildcard certificates (e.g. *.bauer-group.com) and for
# hosts not reachable from the public internet on port 80/443. The
# `letsencrypt-dns` resolver in traefik.yml is parameterised: pick a
# provider by setting LETSENCRYPT_DNS_PROVIDER below; credentials for
# every supported provider are wired through docker-compose.yml.
#
# Leave LETSENCRYPT_DNS_PROVIDER unset (or empty) to keep DNS-01
# effectively disabled (the resolver still exists but won't acquire
# certs).
#
# Full provider list (100+):
#   https://doc.traefik.io/traefik/https/acme/#providers
#
# Below: curated set of pre-wired providers. Pick ONE block, set
# LETSENCRYPT_DNS_PROVIDER, fill in the credentials.

# ── Cloudflare ──────────────────────────────────────────────────────────────
# LETSENCRYPT_DNS_PROVIDER=cloudflare
# Recommended -- scoped API token (Zone:DNS:Edit on the relevant zone):
# CF_DNS_API_TOKEN=
# OR (legacy, full account access -- avoid in prod):
# CF_API_EMAIL=
# CF_API_KEY=

# ── AWS Route 53 ────────────────────────────────────────────────────────────
# LETSENCRYPT_DNS_PROVIDER=route53
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-central-1
# AWS_HOSTED_ZONE_ID=                  # optional, auto-detected if absent
# AWS_SESSION_TOKEN=                   # only when using temporary creds (STS)

# ── Google Cloud DNS ────────────────────────────────────────────────────────
# LETSENCRYPT_DNS_PROVIDER=gcloud
# GCE_PROJECT=
# GCE_SERVICE_ACCOUNT_FILE=/run/secrets/gcp.json   # path inside container
# # OR inline JSON (less secure):
# # GCE_SERVICE_ACCOUNT='{"type":"service_account",...}'

# ── Azure DNS ───────────────────────────────────────────────────────────────
# LETSENCRYPT_DNS_PROVIDER=azuredns
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_SUBSCRIPTION_ID=
# AZURE_TENANT_ID=
# AZURE_RESOURCE_GROUP=
# AZURE_ENVIRONMENT=public            # public, china, government

# ── Hetzner DNS ─────────────────────────────────────────────────────────────
# LETSENCRYPT_DNS_PROVIDER=hetzner
# HETZNER_API_KEY=

# ── IONOS (1&1) ─────────────────────────────────────────────────────────────
# LETSENCRYPT_DNS_PROVIDER=ionos
# IONOS_API_KEY=                       # public.secret format

# ── Netcup (DE) ─────────────────────────────────────────────────────────────
# LETSENCRYPT_DNS_PROVIDER=netcup
# NETCUP_CUSTOMER_NUMBER=
# NETCUP_API_KEY=
# NETCUP_API_PASSWORD=

# ── INWX (DE registrar) ─────────────────────────────────────────────────────
# LETSENCRYPT_DNS_PROVIDER=inwx
# INWX_USERNAME=
# INWX_PASSWORD=
# INWX_SHARED_SECRET=                  # 2FA TOTP secret if enabled
# INWX_SANDBOX=false

# ── Hosting.de ──────────────────────────────────────────────────────────────
# LETSENCRYPT_DNS_PROVIDER=hostingde
# HOSTINGDE_API_KEY=
# HOSTINGDE_ZONE_NAME=

# ── DigitalOcean ────────────────────────────────────────────────────────────
# LETSENCRYPT_DNS_PROVIDER=digitalocean
# DO_AUTH_TOKEN=

# ── Linode ──────────────────────────────────────────────────────────────────
# LETSENCRYPT_DNS_PROVIDER=linode
# LINODE_TOKEN=

# ── Vultr ───────────────────────────────────────────────────────────────────
# LETSENCRYPT_DNS_PROVIDER=vultr
# VULTR_API_KEY=

# ── OVH ─────────────────────────────────────────────────────────────────────
# LETSENCRYPT_DNS_PROVIDER=ovh
# OVH_ENDPOINT=ovh-eu                  # ovh-eu | ovh-ca | ovh-us | ...
# OVH_APPLICATION_KEY=
# OVH_APPLICATION_SECRET=
# OVH_CONSUMER_KEY=

# ── Gandi v5 ────────────────────────────────────────────────────────────────
# LETSENCRYPT_DNS_PROVIDER=gandiv5
# GANDIV5_PERSONAL_ACCESS_TOKEN=       # preferred (newer auth)
# # OR (legacy):
# # GANDIV5_API_KEY=

# ── DNSimple ────────────────────────────────────────────────────────────────
# LETSENCRYPT_DNS_PROVIDER=dnsimple
# DNSIMPLE_OAUTH_TOKEN=
# DNSIMPLE_BASE_URL=                   # optional (sandbox.dnsimple.com)

# ── Namecheap ───────────────────────────────────────────────────────────────
# LETSENCRYPT_DNS_PROVIDER=namecheap
# NAMECHEAP_API_USER=
# NAMECHEAP_API_KEY=

# ── GoDaddy ─────────────────────────────────────────────────────────────────
# LETSENCRYPT_DNS_PROVIDER=godaddy
# GODADDY_API_KEY=
# GODADDY_API_SECRET=

# ── DNSPod / Tencent Cloud ──────────────────────────────────────────────────
# LETSENCRYPT_DNS_PROVIDER=dnspod
# DNSPOD_API_KEY=
# # Or for Tencent Cloud DNS (newer API):
# # LETSENCRYPT_DNS_PROVIDER=tencentcloud
# # TENCENTCLOUD_SECRET_ID=
# # TENCENTCLOUD_SECRET_KEY=

# ── DuckDNS (free dynamic DNS) ──────────────────────────────────────────────
# LETSENCRYPT_DNS_PROVIDER=duckdns
# DUCKDNS_TOKEN=

# ── Designate (OpenStack) ───────────────────────────────────────────────────
# LETSENCRYPT_DNS_PROVIDER=designate
# OS_AUTH_URL=
# OS_USERNAME=
# OS_PASSWORD=
# OS_TENANT_NAME=
# OS_REGION_NAME=

# ── Scaleway ────────────────────────────────────────────────────────────────
# LETSENCRYPT_DNS_PROVIDER=scaleway
# SCW_ACCESS_KEY=
# SCW_SECRET_KEY=
# SCW_PROJECT_ID=

# ── ACME-DNS (alias mode -- works with ANY DNS provider via CNAME) ──────────
# LETSENCRYPT_DNS_PROVIDER=acme-dns
# ACME_DNS_API_BASE=https://auth.acme-dns.io
# ACME_DNS_STORAGE_PATH=/etc/traefik/certs/letsencrypt/acme-dns-accounts.json

# ── RFC 2136 (BIND, Knot, PowerDNS via dynamic updates) ─────────────────────
# LETSENCRYPT_DNS_PROVIDER=rfc2136
# RFC2136_NAMESERVER=ns1.example.com:53
# RFC2136_TSIG_ALGORITHM=hmac-sha256
# RFC2136_TSIG_KEY=
# RFC2136_TSIG_SECRET=

# ── Generic exec hook (custom shell script -- last resort) ──────────────────
# LETSENCRYPT_DNS_PROVIDER=exec
# EXEC_PATH=/etc/traefik/dns-exec.sh
# EXEC_MODE=                           # raw | default


# -----------------------------------------------------------------------------
# Manual certificates
# -----------------------------------------------------------------------------
# Drop *.crt + *.key files into config/certs/static/ and reference them
# from config/traefik/dynamic/tls.yml. The directory is mounted
# read-only into Traefik and watched for changes -- no restart needed.
# For the *.bauer-group.com wildcard specifically, see the opt-in
# template at config/traefik/dynamic/tls-wildcard-bauer-group.yml.disabled
# (no env vars needed -- file-rename activation).


# -----------------------------------------------------------------------------
# Monitoring profile (only when COMPOSE_PROFILES contains "monitoring")
# -----------------------------------------------------------------------------

# Image tags. Float on `latest` by default -- Watchtower (if active)
# keeps them fresh on the weekly schedule. Pin a digest in regulated
# environments.
# Defaults: latest (each)
# PROMETHEUS_IMAGE_TAG=latest
# GRAFANA_IMAGE_TAG=latest
# LOKI_IMAGE_TAG=latest
# PROMTAIL_IMAGE_TAG=latest
# ALERTMANAGER_IMAGE_TAG=latest
# CADVISOR_IMAGE_TAG=latest
# NODE_EXPORTER_IMAGE_TAG=latest

# Grafana admin credentials. CHANGE BEFORE EXPOSING.
# Defaults: admin / changeme
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=changeme

# Grafana login layer. Default = anonymous-viewer ON, because Grafana
# already sits BEHIND the api-entrypoint BasicAuth + IP whitelist --
# a second login at the Grafana layer is friction without security
# gain (you proved trust at the Traefik wall already). Editing
# dashboards / changing settings still requires a Grafana login with
# GRAFANA_ADMIN_USER/PASSWORD.
#
# Set ANONYMOUS_ENABLED=false to force a Grafana login even for
# read-only viewing -- typical for multi-tenant teams that share the
# api wall but want per-user audit trails in Grafana.
#
# Org role for anonymous viewers: Viewer (default) | Editor | Admin.
# Editor would let anyone behind the BasicAuth wall mutate dashboards
# without identifying themselves -- only flip to Editor if that's
# acceptable in your environment.
# Defaults: GF_AUTH_ANONYMOUS_ENABLED=true / GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer
# GF_AUTH_ANONYMOUS_ENABLED=false
# GF_AUTH_ANONYMOUS_ORG_ROLE=Editor

# Comma-separated list of Grafana plugins to install on first start.
# Empty = no extra plugins.
#   grafana-piechart-panel       -- legacy pie panel
#   grafana-clock-panel          -- timezone clock
#   grafana-worldmap-panel       -- geo overlay
# Default: empty
# GRAFANA_PLUGINS=grafana-clock-panel,grafana-piechart-panel

# Prometheus retention. Whichever limit (time or size) hits first wins.
# Defaults: 30d / 8GB
# PROMETHEUS_RETENTION_TIME=90d
# PROMETHEUS_RETENTION_SIZE=20GB

# Scrape interval (Prometheus polling cadence).
# Default: 15s -- 5s if you need fine-grained latency graphs.
# PROMETHEUS_SCRAPE_INTERVAL=5s

# Loki retention (chunk lifetime).
# Default: 168h (= 7 days)
# LOKI_RETENTION_PERIOD=720h


# -----------------------------------------------------------------------------
# Auto-update profile (only when COMPOSE_PROFILES contains "auto-update")
# -----------------------------------------------------------------------------

# Watchtower image. Default `nickfedor/watchtower:latest` is the
# community fork with rolling-restart support. Switch to
# `containrrr/watchtower:latest` for the upstream original.
# Default: nickfedor/watchtower:latest
# WATCHTOWER_IMAGE=containrrr/watchtower:latest

# Six-field cron (sec min hour dom month dow).
#   "0 0 3 * * 6"    -> Saturday 03:00      (default; quiet weekend window)
#   "0 0 4 * * 0"    -> Sunday   04:00
#   "0 0 */6 * * *"  -> every 6 hours       (aggressive, NOT recommended)
# Default: 0 0 3 * * 6 (Sat 03:00)
# WATCHTOWER_SCHEDULE=0 0 4 * * 0

# Wait this long for clean container shutdown before SIGKILL. Match it
# to the longest stop_grace_period in the stack (Traefik default = 30s).
# Default: 60s
# WATCHTOWER_TIMEOUT=120s

# Watchtower notifications (Slack, email, Telegram, ...).
# See https://containrrr.dev/watchtower/notifications/ for full reference.
# WATCHTOWER_NOTIFICATIONS=slack
# WATCHTOWER_NOTIFICATION_SLACK_HOOK_URL=
# WATCHTOWER_NOTIFICATION_SLACK_IDENTIFIER=edgeproxy


# -----------------------------------------------------------------------------
# Resource limits  (asymmetric: Traefik uncapped, helpers capped)
# -----------------------------------------------------------------------------
# Two different cap risks, treated differently:
#
#   1. Traefik (the edge proxy) is intentionally UNCAPPED. Capping its
#      CPU triggers Linux CFS throttling -- 100ms freezes that look
#      like 502s / timeouts to clients even when the host has idle
#      headroom. Override via docker-compose.override.yml only if you
#      have a specific reason (multi-tenant Docker host, regulatory
#      ceiling).
#   2. Monitoring helpers ARE capped, with realistic defaults sized
#      for typical BG single-host deployments. Caps protect the host
#      against runaway scenarios (Prometheus cardinality explosion,
#      Grafana plugin memory leak, Loki ingestion spike, cAdvisor CPU
#      spike on heavy container churn).
#
# Defaults are headroom-y for normal operation. Raise per-service if
# you ingest higher metric/log rates or run heavier dashboards.

# ── Sizing guidance ─────────────────────────────────────────────────────────
# Defaults are SMALL-HOST-SAFE -- tuned for a typical 8 GB RAM / 4-8 core
# Docker host. The total monitoring footprint with defaults is roughly
# 3.2 GB memory caps + ~5 cores cap, leaving 4-5 GB and 3-4 cores free
# for Traefik + customer apps + OS on an 8 GB host.
#
# On a larger host (e.g. 48 cores / 256 GB) you may want more headroom
# for richer dashboards, longer retention, more apps producing metrics.
# Uncomment the LARGE-HOST examples in each section -- they are 2-4x
# the defaults.
#
# Architectural guarantee on host stability:
#   * Traefik:    oom_score_adj=-50  (light bias above monitoring,
#                                     about same priority as apps)
#   * Monitoring: oom_score_adj=+200 (preferred OOM victim)
#   * sshd / dockerd: -500 (distro default at host-systemd level --
#                           verify with `traefik.sh check-host-isolation`)
#   * No `pids_limit` is set per-container -- intentional, see
#     docs/operations/known-limitations.md for rationale.
#   * Logging is `mode: non-blocking` -- a stalled log shipper drops
#     lines instead of blocking application stdout.
# Result: monitoring failure cannot take down Traefik; OOM events kill
# helpers first, then apps, then Traefik -- system services and SSH
# are NEVER reached under normal pressure.

# ---- Prometheus (sized for ~6-10 scrape targets at 15-30s) ----
# Defaults: 1 / 1g (small-host-safe)
# PROMETHEUS_CPU_LIMIT=1
# PROMETHEUS_MEMORY_LIMIT=1g
# Large-host (48c/256g) example -- raise for longer retention or
# higher-cardinality apps:
# PROMETHEUS_CPU_LIMIT=4
# PROMETHEUS_MEMORY_LIMIT=8g

# ---- Grafana ----
# Defaults: 1 / 384m (small-host-safe; bump for many plugins)
# GRAFANA_CPU_LIMIT=1
# GRAFANA_MEMORY_LIMIT=384m
# Large-host example:
# GRAFANA_CPU_LIMIT=2
# GRAFANA_MEMORY_LIMIT=1g

# ---- Loki (sized for ~10 MB/min ingest from 1 proxy + 10-20 apps) ----
# Defaults: 1 / 768m (small-host-safe)
# LOKI_CPU_LIMIT=1
# LOKI_MEMORY_LIMIT=768m
# Large-host example -- more memory = more active streams cached:
# LOKI_CPU_LIMIT=2
# LOKI_MEMORY_LIMIT=4g

# ---- Promtail (lightweight log shipper) ----
# Defaults: 0.5 / 256m (small-host-safe; raise on heavy log volume)
# PROMTAIL_CPU_LIMIT=0.5
# PROMTAIL_MEMORY_LIMIT=256m

# ---- Alertmanager ----
# Defaults: 0.25 / 128m (small-host-safe)
# ALERTMANAGER_CPU_LIMIT=0.25
# ALERTMANAGER_MEMORY_LIMIT=128m

# ---- node-exporter ----
# Defaults: 0.25 / 128m (small-host-safe)
# NODE_EXPORTER_CPU_LIMIT=0.25
# NODE_EXPORTER_MEMORY_LIMIT=128m

# ---- cAdvisor ----
# Defaults: 0.5 / 384m (small-host-safe). Raise if you run high-churn
# workloads (CI build agents, ephemeral containers) -- cAdvisor scans
# every container creation/destruction event.
# CADVISOR_CPU_LIMIT=0.5
# CADVISOR_MEMORY_LIMIT=384m

# ---- Watchtower ----
# Defaults: 0.5 / 256m (small-host-safe -- 256m needed for image-pull
# transient memory; smaller caps OOM during a multi-hundred-MB image
# update).
# WATCHTOWER_CPU_LIMIT=0.5
# WATCHTOWER_MEMORY_LIMIT=256m


# -----------------------------------------------------------------------------
# Logging (Docker json-file driver)
# -----------------------------------------------------------------------------
# All services run the json-file driver in `mode: non-blocking` with a
# generous ring buffer. CRITICAL guarantee: under heavy traffic or a
# slow log shipper, the application NEVER blocks on log writes -- the
# driver drops log lines instead. Logs are non-critical, serving traffic
# is critical.

# Per-container ring buffer size. ~10-50k log lines depending on length.
# Increase if you legitimately log >50k lines/sec/container.
# Default: 4m
# LOG_MAX_BUFFER_SIZE=16m

# Per-container log rotation. Default = 50 MB x 5 files = 250 MB max.
# Defaults: 50m / 5
# LOG_MAX_SIZE=100m
# LOG_MAX_FILE=10
