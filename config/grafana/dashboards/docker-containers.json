{
  "description": "Per-container CPU / memory / I/O metrics from cAdvisor.",
  "editable": true,
  "graphTooltip": 1,
  "annotations": {
    "list": [
      { "builtIn": 1, "datasource": { "type": "grafana", "uid": "-- Grafana --" }, "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "name": "Annotations & Alerts", "type": "dashboard" },
      { "datasource": { "type": "prometheus", "uid": "prometheus" }, "enable": true, "iconColor": "red", "name": "Firing Alerts", "expr": "ALERTS{alertstate=\"firing\"}", "step": "30s", "titleFormat": "{{ alertname }}", "tagKeys": "severity,name,container,service" }
    ]
  },
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 5,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"$name\",name!=\"\"}[1m]))",
          "legendFormat": "{{ name }}",
          "refId": "A"
        }
      ],
      "title": "Container CPU Usage (cores)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 5,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (name) (container_memory_working_set_bytes{name=~\"$name\",name!=\"\"})",
          "legendFormat": "{{ name }}",
          "refId": "A"
        }
      ],
      "title": "Container Memory Working Set",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 5,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "Bps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "options": {
        "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (name) (rate(container_network_receive_bytes_total{name=~\"$name\",name!=\"\"}[1m]))",
          "legendFormat": "rx {{ name }}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "-sum by (name) (rate(container_network_transmit_bytes_total{name=~\"$name\",name!=\"\"}[1m]))",
          "legendFormat": "tx {{ name }}",
          "refId": "B"
        }
      ],
      "title": "Container Network I/O",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 5,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "options": {
        "legend": { "calcs": ["max"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(container_cpu_cfs_throttled_periods_total{name=~\"$name\",name!=\"\"}[5m]) / clamp_min(rate(container_cpu_cfs_periods_total{name=~\"$name\",name!=\"\"}[5m]), 0.001)",
          "legendFormat": "{{ name }}",
          "refId": "A"
        }
      ],
      "title": "CPU Throttle Ratio (warn > 25%)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Counter of how many times each container's main process has restarted. Healthy steady-state = flat at 0; non-zero spikes = crash or watchtower update.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "fillOpacity": 80, "lineWidth": 1, "showPoints": "never", "spanNulls": false, "stacking": { "group": "A", "mode": "normal" } },
          "unit": "short"
        }
      },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 16 },
      "id": 5,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "right", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (name) (changes(container_start_time_seconds{name=~\"$name\",name!=\"\"}[1h]))", "legendFormat": "{{ name }}", "refId": "A" }
      ],
      "title": "Container Restarts (last 1h)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "OOM-killer events found in container stdout. NOTE: host kernel / dockerd OOM lines are NOT in Loki unless the daemon logs into a scraped container -- check `dmesg` / journald on the host for those. Empty = no recent OOM events in container logs.",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 16 },
      "id": 6,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        { "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "expr": "{container=~\".+\"} |~ \"(?i)oom|killed|out of memory|memory cgroup out of memory\"", "queryType": "range", "refId": "A" }
      ],
      "title": "OOM / Memory-kill Events",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["edgeproxy", "containers", "docker"],
  "templating": { "list": [
    {
      "current": { "text": "All", "value": "$__all", "selected": false },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "definition": "label_values(container_last_seen, name)",
      "includeAll": true,
      "allValue": ".+",
      "label": "Container",
      "multi": true,
      "name": "name",
      "query": { "query": "label_values(container_last_seen, name)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
      "refresh": 2,
      "sort": 1,
      "type": "query"
    }
  ] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "EDGEPROXY -- Containers",
  "uid": "edgeproxy-containers",
  "version": 1
}
