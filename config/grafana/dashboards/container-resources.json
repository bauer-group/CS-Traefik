{
  "description": "Resource & load monitor -- which container consumes how much CPU / RAM / network / disk, ranked against host capacity (node-exporter). cAdvisor measures cgroups (= containers), not individual PIDs; for per-process detail add a process-exporter.",
  "editable": true,
  "graphTooltip": 1,
  "annotations": {
    "list": [
      { "builtIn": 1, "datasource": { "type": "grafana", "uid": "-- Grafana --" }, "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "name": "Annotations & Alerts", "type": "dashboard" },
      { "datasource": { "type": "prometheus", "uid": "prometheus" }, "enable": true, "iconColor": "red", "name": "Firing Alerts", "expr": "ALERTS{alertstate=\"firing\"}", "step": "30s", "titleFormat": "{{ alertname }}", "tagKeys": "severity,name,container,service" }
    ]
  },
  "links": [
    { "asDropdown": true, "icon": "external link", "includeVars": true, "keepTime": true, "tags": ["edgeproxy"], "targetBlank": false, "title": "Dashboards", "type": "dashboards" }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": [],
      "title": "Host Capacity (node-exporter)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Host CPU utilisation across all cores. The headroom every container is competing for.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 85 } ] }, "unit": "percent" } },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": { "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": false, "showThresholdMarkers": true },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval])))", "refId": "A" } ],
      "title": "Host CPU Used",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Host RAM in use (MemTotal - MemAvailable). MemAvailable already accounts for reclaimable cache.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 90 } ] }, "unit": "percent" } },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": { "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": false, "showThresholdMarkers": true },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "refId": "A" } ],
      "title": "Host RAM Used",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Load average normalised per core (load / nCPU). 1.0 = fully subscribed; >1.0 = tasks waiting on CPU.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.8 }, { "color": "red", "value": 1 } ] }, "unit": "short", "decimals": 2 } },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value_and_name" },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "node_load1 / scalar(count(count(node_cpu_seconds_total) by (cpu)))", "legendFormat": "1m", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "node_load5 / scalar(count(count(node_cpu_seconds_total) by (cpu)))", "legendFormat": "5m", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "node_load15 / scalar(count(count(node_cpu_seconds_total) by (cpu)))", "legendFormat": "15m", "refId": "C" }
      ],
      "title": "Load / core",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Total host network throughput (physical NICs only -- veth / docker / bridge / loopback excluded).",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }, "unit": "Bps" } },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value_and_name" },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(node_network_receive_bytes_total{device!~\"lo|veth.*|docker.*|br-.*|cali.*\"}[$__rate_interval]))", "legendFormat": "rx", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|docker.*|br-.*|cali.*\"}[$__rate_interval]))", "legendFormat": "tx", "refId": "B" }
      ],
      "title": "Host Network",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 101,
      "panels": [],
      "title": "Top Consumers (right now)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Containers ranked by current CPU. Cores = absolute usage; % of Host = share of total machine CPU; Throttle = how often the CFS quota capped the container (sustained >25% means the CPU limit is too tight).",
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true }, "thresholds": { "mode": "absolute", "steps": [ { "color": "text", "value": null } ] } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "% of Host" }, "properties": [ { "id": "unit", "value": "percent" }, { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } }, { "id": "max", "value": 100 } ] },
          { "matcher": { "id": "byName", "options": "Throttle %" }, "properties": [ { "id": "unit", "value": "percent" }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 25 }, { "color": "red", "value": 50 } ] } }, { "id": "custom.cellOptions", "value": { "type": "color-text" } } ] },
          { "matcher": { "id": "byName", "options": "Cores" }, "properties": [ { "id": "unit", "value": "short" }, { "id": "decimals", "value": 3 } ] }
        ]
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 8 },
      "id": 5,
      "options": { "cellHeight": "sm", "footer": { "show": false }, "showHeader": true, "sortBy": [ { "displayName": "Cores", "desc": true } ] },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"$name\",name!=\"\"}[$__rate_interval]))", "format": "table", "instant": true, "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"$name\",name!=\"\"}[$__rate_interval])) / scalar(count(count(node_cpu_seconds_total) by (cpu))) * 100", "format": "table", "instant": true, "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (name) (rate(container_cpu_cfs_throttled_periods_total{name=~\"$name\",name!=\"\"}[$__rate_interval])) / clamp_min(sum by (name) (rate(container_cpu_cfs_periods_total{name=~\"$name\",name!=\"\"}[$__rate_interval])), 0.001) * 100", "format": "table", "instant": true, "refId": "C" }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "indexByName": {}, "renameByName": { "name": "Container", "Value #A": "Cores", "Value #B": "% of Host", "Value #C": "Throttle %" } } }
      ],
      "title": "Top Containers by CPU",
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Containers ranked by current memory (working set = resident, non-reclaimable). Limit / % of Limit show how close each sits to its cgroup memory cap -- the value the OOM-killer watches. Blank Limit = no memory limit set.",
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true }, "thresholds": { "mode": "absolute", "steps": [ { "color": "text", "value": null } ] } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Working Set" }, "properties": [ { "id": "unit", "value": "bytes" } ] },
          { "matcher": { "id": "byName", "options": "Limit" }, "properties": [ { "id": "unit", "value": "bytes" } ] },
          { "matcher": { "id": "byName", "options": "% of Limit" }, "properties": [ { "id": "unit", "value": "percent" }, { "id": "max", "value": 100 }, { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 80 }, { "color": "red", "value": 95 } ] } } ] }
        ]
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 8 },
      "id": 6,
      "options": { "cellHeight": "sm", "footer": { "show": false }, "showHeader": true, "sortBy": [ { "displayName": "Working Set", "desc": true } ] },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (name) (container_memory_working_set_bytes{name=~\"$name\",name!=\"\"})", "format": "table", "instant": true, "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (name) (container_spec_memory_limit_bytes{name=~\"$name\",name!=\"\"} > 0)", "format": "table", "instant": true, "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (name) (container_memory_working_set_bytes{name=~\"$name\",name!=\"\"}) / (sum by (name) (container_spec_memory_limit_bytes{name=~\"$name\",name!=\"\"}) > 0) * 100", "format": "table", "instant": true, "refId": "C" }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "indexByName": {}, "renameByName": { "name": "Container", "Value #A": "Working Set", "Value #B": "Limit", "Value #C": "% of Limit" } } }
      ],
      "title": "Top Containers by Memory",
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "id": 102,
      "panels": [],
      "title": "Per-container Trends",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "CPU consumed per container, in cores.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 8, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true, "stacking": { "group": "A", "mode": "none" } }, "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "id": 7,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"$name\",name!=\"\"}[$__rate_interval]))", "legendFormat": "{{ name }}", "refId": "A" } ],
      "title": "CPU Usage (cores)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Memory working set per container (resident, non-reclaimable -- the OOM-relevant figure).",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 8, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true, "stacking": { "group": "A", "mode": "none" } }, "unit": "bytes" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "id": 8,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (name) (container_memory_working_set_bytes{name=~\"$name\",name!=\"\"})", "legendFormat": "{{ name }}", "refId": "A" } ],
      "title": "Memory Working Set",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Network throughput per container. Positive = received (rx), negative = transmitted (tx).",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisCenteredZero": true, "drawStyle": "line", "fillOpacity": 8, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true }, "unit": "Bps" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "id": 9,
      "options": { "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "right", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (name) (rate(container_network_receive_bytes_total{name=~\"$name\",name!=\"\"}[$__rate_interval]))", "legendFormat": "rx {{ name }}", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "-sum by (name) (rate(container_network_transmit_bytes_total{name=~\"$name\",name!=\"\"}[$__rate_interval]))", "legendFormat": "tx {{ name }}", "refId": "B" }
      ],
      "title": "Network I/O",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Disk throughput per container (bytes/s). Positive = read, negative = write. NOTE: cAdvisor disk metrics depend on the host's blkio cgroup -- may read empty on some kernels / overlay setups.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisCenteredZero": true, "drawStyle": "line", "fillOpacity": 8, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true }, "unit": "Bps" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "id": 10,
      "options": { "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "right", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (name) (rate(container_fs_reads_bytes_total{name=~\"$name\",name!=\"\"}[$__rate_interval]))", "legendFormat": "read {{ name }}", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "-sum by (name) (rate(container_fs_writes_bytes_total{name=~\"$name\",name!=\"\"}[$__rate_interval]))", "legendFormat": "write {{ name }}", "refId": "B" }
      ],
      "title": "Disk Throughput",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Disk operations per second per container (IOPS). Positive = read ops, negative = write ops. High IOPS with low throughput = many small I/Os, the pattern that saturates network / spinning disks.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisCenteredZero": true, "drawStyle": "line", "fillOpacity": 8, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true }, "unit": "iops" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 34 },
      "id": 11,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (name) (rate(container_fs_reads_total{name=~\"$name\",name!=\"\"}[$__rate_interval]))", "legendFormat": "read {{ name }}", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "-sum by (name) (rate(container_fs_writes_total{name=~\"$name\",name!=\"\"}[$__rate_interval]))", "legendFormat": "write {{ name }}", "refId": "B" }
      ],
      "title": "Disk IOPS",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Fraction of CFS scheduling periods where the container was throttled by its CPU limit. Sustained >25% = the container wants more CPU than its limit allows -- raise the limit or accept the cap.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true }, "unit": "percentunit", "min": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.25 }, { "color": "red", "value": 0.5 } ] } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 34 },
      "id": 12,
      "options": { "legend": { "calcs": ["max"], "displayMode": "table", "placement": "right", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(container_cpu_cfs_throttled_periods_total{name=~\"$name\",name!=\"\"}[$__rate_interval]) / clamp_min(rate(container_cpu_cfs_periods_total{name=~\"$name\",name!=\"\"}[$__rate_interval]), 0.001)", "legendFormat": "{{ name }}", "refId": "A" } ],
      "title": "CPU Throttle Ratio",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 42 },
      "id": 103,
      "panels": [],
      "title": "Share of Host (stacked)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Each container's CPU as a percentage of total host CPU, stacked. The top of the stack is the host's total container-attributable CPU; the gap to 100% is host/system overhead.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 35, "lineInterpolation": "smooth", "lineWidth": 1, "showPoints": "never", "spanNulls": true, "stacking": { "group": "A", "mode": "normal" } }, "unit": "percent" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 43 },
      "id": 13,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"$name\",name!=\"\"}[$__rate_interval])) / scalar(count(count(node_cpu_seconds_total) by (cpu))) * 100", "legendFormat": "{{ name }}", "refId": "A" } ],
      "title": "Share of Host CPU",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Each container's working-set memory as a percentage of host MemTotal, stacked.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 35, "lineInterpolation": "smooth", "lineWidth": 1, "showPoints": "never", "spanNulls": true, "stacking": { "group": "A", "mode": "normal" } }, "unit": "percent" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 43 },
      "id": 14,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (name) (container_memory_working_set_bytes{name=~\"$name\",name!=\"\"}) / scalar(node_memory_MemTotal_bytes) * 100", "legendFormat": "{{ name }}", "refId": "A" } ],
      "title": "Share of Host RAM",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["edgeproxy", "resources", "containers", "system"],
  "templating": { "list": [
    {
      "current": { "text": "All", "value": "$__all", "selected": false },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "definition": "label_values(container_last_seen, name)",
      "includeAll": true,
      "allValue": ".+",
      "label": "Container",
      "multi": true,
      "name": "name",
      "query": { "query": "label_values(container_last_seen, name)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
      "refresh": 2,
      "sort": 1,
      "type": "query"
    }
  ] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "EDGEPROXY -- Resource Monitor",
  "uid": "edgeproxy-resources",
  "version": 1
}
