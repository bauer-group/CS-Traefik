{
  "description": "Source-IP analysis -- top clients, abuse signals, error-by-client. Uses the Traefik access log (ClientHost) via Loki. NOTE: the access log is filtered to 4xx/5xx responses (traefik.yml statusCodes 400-599), so the client panels surface ERROR-producing / abusive clients, not total traffic. For total request volume use the Prometheus traefik_* dashboards.",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": [],
      "title": "Client KPIs",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Distinct client IPs that produced a 4xx/5xx response over the time range (the access log is errors-only). A sudden spike often correlates with crawler / scan activity.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }, "unit": "short" } },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "targets": [
        { "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "expr": "count(sum by (ClientHost) (count_over_time({job=\"traefik\", source=\"access\"} | json [1h])))", "queryType": "instant", "refId": "A" }
      ],
      "title": "Distinct Error Clients (1h)",
      "type": "stat"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Error responses per second from the noisiest single client (access log is 4xx/5xx-only). Helps spot brute-force / scan / DDoS sources.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 200 } ] }, "unit": "reqps" } },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["max"] }, "textMode": "auto" },
      "targets": [
        { "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "expr": "topk(1, sum by (ClientHost) (rate({job=\"traefik\", source=\"access\"} | json [1m])))", "refId": "A" }
      ],
      "title": "Top Single Error Client Req/s",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Total 4xx-class responses across the stack. Brute-force on /login produces lots of 401/403; scrapers produce 404/405.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 10 } ] }, "unit": "ops" } },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(traefik_service_requests_total{code=~\"4..\"}[5m]))", "refId": "A" }
      ],
      "title": "4xx Rate /s",
      "type": "stat"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "401 / 403 responses across access logs over 5 min. Brute-force on auth endpoints elevates this even when overall 4xx looks normal.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 30 } ] }, "unit": "short" } },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "targets": [
        { "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "expr": "sum(count_over_time({job=\"traefik\", source=\"access\", status=~\"40[13]\"} [5m]))", "queryType": "instant", "refId": "A" }
      ],
      "title": "401/403 (5m)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 200,
      "panels": [],
      "title": "Top Clients",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Top 20 source IPs by request count in the access log (4xx/5xx-only). Sort by count to find heavy hitters; cross-reference against the abuse-signal panels below to decide if any deserve a temporary IP-block.",
      "fieldConfig": {
        "defaults": { "custom": { "align": "left", "displayMode": "auto" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 1000 } ] }, "unit": "short" },
        "overrides": [ { "matcher": { "id": "byName", "options": "Requests" }, "properties": [ { "id": "custom.cellOptions", "value": { "type": "color-background" } }, { "id": "custom.align", "value": "right" } ] } ]
      },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "options": { "showHeader": true, "footer": { "show": false }, "sortBy": [ { "displayName": "Requests", "desc": true } ] },
      "targets": [
        { "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "expr": "topk(20, sum by (ClientHost) (count_over_time({job=\"traefik\", source=\"access\"} | json [$__range])))", "format": "table", "instant": true, "refId": "A" }
      ],
      "title": "Top 20 Source IPs by Count",
      "transformations": [ { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "ClientHost": "Client IP", "Value": "Requests" } } } ],
      "type": "table"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Top 10 source IPs that produced 4xx + 5xx errors. Brute-force, scrapers, and probes show up here disproportionally.",
      "fieldConfig": {
        "defaults": { "custom": { "align": "left", "displayMode": "auto" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 500 } ] }, "unit": "short" },
        "overrides": [ { "matcher": { "id": "byName", "options": "Errors" }, "properties": [ { "id": "custom.cellOptions", "value": { "type": "color-background" } }, { "id": "custom.align", "value": "right" } ] } ]
      },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "options": { "showHeader": true, "footer": { "show": false }, "sortBy": [ { "displayName": "Errors", "desc": true } ] },
      "targets": [
        { "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "expr": "topk(10, sum by (ClientHost) (count_over_time({job=\"traefik\", source=\"access\", status=~\"4..|5..\"} | json [$__range])))", "format": "table", "instant": true, "refId": "A" }
      ],
      "title": "Top 10 Error-Producing Clients",
      "transformations": [ { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "ClientHost": "Client IP", "Value": "Errors" } } } ],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 300,
      "panels": [],
      "title": "Abuse Signals (auth + path)",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Per-client 401/403 rate -- brute-force authentication attempts cluster here. Sustained > 1/s from a single source = consider IP-blocking that client.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "fillOpacity": 70, "lineWidth": 1, "showPoints": "never", "stacking": { "group": "A", "mode": "normal" } },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 17 },
      "id": 7,
      "options": { "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "right", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "expr": "topk(10, sum by (ClientHost) (count_over_time({job=\"traefik\", source=\"access\", status=~\"40[13]\"} | json [1m])))", "queryType": "range", "refId": "A" }
      ],
      "title": "401/403 by Client (top 10 over time)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Path-scan probes -- common attack/scan signatures (.env, wp-admin, .git, etc.) that legitimate users do not request.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 25 },
      "id": 8,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        { "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "expr": "{job=\"traefik\", source=\"access\"} |~ \"(?i)(\\\\.env|\\\\.git|wp-admin|wp-login|phpmyadmin|\\\\.aws|/admin/config\\\\.php|\\\\.well-known/security|/console|/server-status)\"", "queryType": "range", "refId": "A" }
      ],
      "title": "Probe / Scan Signatures (Loki regex)",
      "type": "logs"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["edgeproxy", "client", "abuse", "security"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "",
  "title": "EDGEPROXY -- Client Analysis",
  "uid": "edgeproxy-clients",
  "version": 1,
  "weekStart": ""
}
